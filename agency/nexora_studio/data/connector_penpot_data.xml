<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Penpot Connector -->
        <record id="connector_penpot_mcp" model="nexora.connector">
            <field name="name">Penpot Design MCP</field>
            <field name="connector_id">penpot_mcp</field>
            <field name="connector_type_id" search="[('type_code', '=', 'mcp')]"/>
            <field name="version">1.0.0</field>
            <field name="state">registered</field>
            <field name="description">Penpot MCP server for design workspace orchestration, project inspection, and shape export.</field>
            <field name="author">Penpot</field>
            <field name="homepage_url">https://github.com/penpot/penpot-mcp</field>
        </record>

        <!-- Penpot MCP Server Configuration (Phase 43.8 corrected: query-parameter API key) -->
        <record id="config_penpot_mcp" model="nexora.mcp_server_config">
            <field name="connector_id" ref="connector_penpot_mcp"/>
            <field name="transport_type">sse</field>
            <field name="command">http://localhost:9001/mcp/sse</field>
            <field name="args_json">[]</field>
            <field name="env_vars_json"><![CDATA[{}]]></field>
            <!--
                Verified against the bundled Penpot MCP server (/opt/penpot/mcp/index.js):
                it never parses `Authorization`/`Bearer` and reads the token only from
                the `userToken` HTTP query parameter. Handled by QueryAuth in transport.py.
            -->
            <field name="authentication_location">query</field>
            <field name="authentication_name">userToken</field>
            <field name="authentication_scheme">none</field>
            <field name="credential_key">PENPOT_API_KEY</field>
            <!-- The durable API key fully replaces per-request browser-session binding. -->
            <field name="session_binding">none</field>
            <!-- Retained so the generic SessionTransportPool fallback stays configurable. -->
            <field name="allowed_request_context_fields_json">["userToken"]</field>
            <field name="timeout_seconds">60</field>
            <field name="startup_policy">lazy</field>
        </record>

        <!-- Credential slot only. The secret value is populated via the Odoo UI and never stored in source control. -->
        <record id="credential_penpot_api_key" model="nexora.mcp_credential">
            <field name="connector_id" ref="connector_penpot_mcp"/>
            <field name="credential_key">PENPOT_API_KEY</field>
            <field name="credential_type">api_key</field>
            <field name="description">Penpot access token sent as the `userToken` query parameter.</field>
        </record>
    </data>
</odoo>
