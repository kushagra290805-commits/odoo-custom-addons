<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- GitHub Connector -->
        <record id="connector_github_mcp" model="nexora.connector">
            <field name="name">GitHub Official MCP</field>
            <field name="connector_id">github_mcp</field>
            <field name="connector_type_id" search="[('type_code', '=', 'mcp')]"/>
            <field name="version">1.0.0</field>
            <field name="state">registered</field>
            <field name="description">Official GitHub MCP server (Docker) for repositories, issues, pull requests, and code search.</field>
            <field name="author">GitHub</field>
            <field name="homepage_url">https://github.com/github/github-mcp-server</field>
        </record>

        <!-- GitHub MCP Server Configuration -->
        <!-- The PAT is passed to the container via the docker -e GITHUB_PERSONAL_ACCESS_TOKEN flag;
             it resolves at runtime from nexora.mcp_credential and is injected into config.args by
             McpOnboardingService — never stored in this file. -->
        <record id="config_github_mcp" model="nexora.mcp_server_config">
            <field name="connector_id" ref="connector_github_mcp"/>
            <field name="transport_type">stdio</field>
            <field name="command">docker</field>
            <field name="args_json">["run", "-i", "--rm", "-e", "GITHUB_PERSONAL_ACCESS_TOKEN", "-e", "GITHUB_READ_ONLY=1", "ghcr.io/github/github-mcp-server"]</field>
            <field name="env_vars_json"><![CDATA[{}]]></field>
            <field name="timeout_seconds">60</field>
            <field name="startup_policy">lazy</field>
        </record>

        <!-- Credential slot only. The secret value is populated via the Odoo UI and never stored in source control. -->
        <record id="credential_github_personal_access_token" model="nexora.mcp_credential">
            <field name="connector_id" ref="connector_github_mcp"/>
            <field name="credential_key">GITHUB_PERSONAL_ACCESS_TOKEN</field>
            <field name="credential_type">api_key</field>
            <field name="description">GitHub personal access token resolved from nexora.mcp_credential; the github-mcp-server container receives it through the docker -e GITHUB_PERSONAL_ACCESS_TOKEN flag.</field>
        </record>
    </data>
</odoo>
