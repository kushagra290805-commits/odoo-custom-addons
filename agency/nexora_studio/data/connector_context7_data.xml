<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Context7 Connector -->
        <record id="connector_context7_mcp" model="nexora.connector">
            <field name="name">Context7 Documentation MCP</field>
            <field name="connector_id">context7_mcp</field>
            <field name="connector_type_id" search="[('type_code', '=', 'mcp')]"/>
            <field name="version">1.0.0</field>
            <field name="state">registered</field>
            <field name="description">Upstash Context7 MCP server for up-to-date library documentation lookup.</field>
            <field name="author">Upstash</field>
            <field name="homepage_url">https://github.com/upstash/context7</field>
        </record>

        <!-- Context7 MCP Server Configuration -->
        <!-- CONTEXT7_API_KEY is NOT set here. Secrets resolve at runtime from nexora.mcp_credential
             and are delivered via the declared env placeholder (ADR-0071). -->
        <record id="config_context7_mcp" model="nexora.mcp_server_config">
            <field name="connector_id" ref="connector_context7_mcp"/>
            <field name="transport_type">stdio</field>
            <field name="command">npx.cmd</field>
            <field name="args_json">["-y", "--quiet", "@upstash/context7-mcp"]</field>
            <field name="env_vars_json"><![CDATA[{}]]></field>
            <field name="timeout_seconds">60</field>
            <field name="startup_policy">lazy</field>
        </record>

        <!-- Credential slot only. The secret value is populated via the Odoo UI and never stored in source control. -->
        <record id="credential_context7_api_key" model="nexora.mcp_credential">
            <field name="connector_id" ref="connector_context7_mcp"/>
            <field name="credential_key">CONTEXT7_API_KEY</field>
            <field name="credential_type">api_key</field>
            <field name="description">Context7 API key injected as the CONTEXT7_API_KEY process environment variable.</field>
        </record>
    </data>
</odoo>
