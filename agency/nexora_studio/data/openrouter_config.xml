<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- OpenRouter Configuration Defaults (Phase 9B) -->
        <record id="openrouter_api_key" model="ir.config_parameter">
            <field name="key">nexora.openrouter.api_key</field>
            <field name="value"></field>
        </record>

        <record id="openrouter_base_url" model="ir.config_parameter">
            <field name="key">nexora.openrouter.base_url</field>
            <field name="value">https://openrouter.ai/api/v1</field>
        </record>

        <record id="openrouter_default_model" model="ir.config_parameter">
            <field name="key">nexora.openrouter.default_model</field>
            <field name="value">tencent/hy3:free</field>
        </record>

        <record id="openrouter_enabled" model="ir.config_parameter">
            <field name="key">nexora.openrouter.enabled</field>
            <field name="value">True</field>
        </record>

        <record id="openrouter_timeout" model="ir.config_parameter">
            <field name="key">nexora.openrouter.timeout</field>
            <field name="value">120</field>
        </record>

    </data>
</odoo>
