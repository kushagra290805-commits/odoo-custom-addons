<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Tavily Connector -->
        <record id="connector_tavily_mcp" model="nexora.connector">
            <field name="name">Tavily Web Research MCP</field>
            <field name="connector_id">tavily_mcp</field>
            <field name="connector_type_id" search="[('type_code', '=', 'mcp')]"/>
            <field name="version">1.0.0</field>
            <field name="state">registered</field>
            <field name="description">Tavily MCP server for web search, extraction, and crawling.</field>
            <field name="author">Tavily AI</field>
            <field name="homepage_url">https://github.com/tavily-ai/tavily-mcp</field>
        </record>

        <!-- Tavily MCP Server Configuration (Phase 43.9: env-var credential injection) -->
        <record id="config_tavily_mcp" model="nexora.mcp_server_config">
            <field name="connector_id" ref="connector_tavily_mcp"/>
            <field name="transport_type">stdio</field>
            <field name="command">npx.cmd</field>
            <field name="args_json">["-y", "--quiet", "tavily-mcp"]</field>
            <!-- TAVILY_API_KEY is NOT set here. Secrets resolve at runtime from nexora.mcp_credential. -->
            <field name="env_vars_json"><![CDATA[{}]]></field>
            <field name="timeout_seconds">60</field>
            <field name="startup_policy">lazy</field>
        </record>

        <!-- Credential slot only. The secret value is populated via the Odoo UI and never stored in source control. -->
        <record id="credential_tavily_api_key" model="nexora.mcp_credential">
            <field name="connector_id" ref="connector_tavily_mcp"/>
            <field name="credential_key">TAVILY_API_KEY</field>
            <field name="credential_type">env_var</field>
            <field name="description">Tavily API key injected as the TAVILY_API_KEY process environment variable.</field>
        </record>
    </data>
</odoo>
