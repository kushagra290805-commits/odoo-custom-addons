<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Periodic Capability Synchronization Job -->
        <record id="ir_cron_sync_capability_discovery" model="ir.cron">
            <field name="name">Nexora: Capability Discovery Sync</field>
            <field name="model_id" ref="model_nexora_capability_discovery_service"/>
            <field name="state">code</field>
            <field name="code">model.execute_discovery()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
