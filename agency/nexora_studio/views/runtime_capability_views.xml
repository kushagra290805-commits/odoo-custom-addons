<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_nexora_runtime_capability_form" model="ir.ui.view">
        <field name="name">nexora.runtime_capability.form</field>
        <field name="model">nexora.runtime_capability</field>
        <field name="arch" type="xml">
            <form string="Runtime Capability">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="runtime_type"/>
                            <field name="provider"/>
                            <field name="version"/>
                            <field name="plugin_service"/>
                            <field name="plugin_class"/>
                        </group>
                        <group>
                            <field name="enabled" widget="boolean_toggle"/>
                            <field name="optional" widget="boolean_toggle"/>
                            <field name="startup_priority"/>
                            <field name="supports_health_checks" widget="boolean_toggle"/>
                            <field name="restart_policy"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Dependencies">
                            <field name="dependency_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </page>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Advanced">
                            <group>
                                <field name="metadata_json" widget="json"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_nexora_runtime_capability_tree" model="ir.ui.view">
        <field name="name">nexora.runtime_capability.tree</field>
        <field name="model">nexora.runtime_capability</field>
        <field name="arch" type="xml">
            <list string="Runtime Capabilities">
                <field name="name"/>
                <field name="runtime_type"/>
                <field name="provider"/>
                <field name="version"/>
                <field name="plugin_service"/>
                <field name="enabled" widget="boolean_toggle"/>
                <field name="startup_priority"/>
                <field name="supports_health_checks"/>
                <field name="restart_policy"/>
                <field name="dependency_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_nexora_runtime_capability_search" model="ir.ui.view">
        <field name="name">nexora.runtime_capability.search</field>
        <field name="model">nexora.runtime_capability</field>
        <field name="arch" type="xml">
            <search string="Search Runtime Capabilities">
                <field name="name"/>
                <field name="runtime_type"/>
                <field name="provider"/>
                <field name="plugin_service"/>
                <separator/>
                <filter string="Enabled" name="enabled" domain="[('enabled', '=', True)]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <filter string="Group by Provider" name="group_by_provider" context="{'group_by': 'provider'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_nexora_runtime_capability" model="ir.actions.act_window">
        <field name="name">Runtime Capabilities</field>
        <field name="res_model">nexora.runtime_capability</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nexora_runtime_capability_search"/>
        <field name="context">{'search_default_enabled': 1}</field>
    </record>



</odoo>
