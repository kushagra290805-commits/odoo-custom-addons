{
  "name": "@splinetool/loader",
  "version": "1.12.98",
  "description": "Spline is a collaborative design platform for creating production-ready interactive experiences in multiple dimensions. © 2025 Spline, Inc.",
  "keywords": [
    "spline",
    "3D",
    "webgl",
    "shader",
    "interactive",
    "collaborative"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/splinetool/spline.git",
    "directory": "packages/loader"
  },
  "type": "module",
  "main": "./build/SplineLoader.js",
  "module": "./build/SplineLoader.js",
  "types": "./SplineLoader.d.ts",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "react-native": "./build/SplineLoader.js",
  "exports": {
    ".": {
      "types": "./SplineLoader.d.ts",
      "import": "./build/SplineLoader.js",
      "require": "./build/SplineLoader.cjs"
    }
  },
  "files": [
    "build",
    "SplineLoader.d.ts"
  ],
  "scripts": {
    "build": "cross-env NODE_ENV=production node --experimental-json-modules ./esbuild.mjs",
    "build-types": "tsc --skipLibCheck --isolatedModules false --noEmit false --emitDeclarationOnly --declaration --outDir build/",
    "lint": "eslint src/ --max-warnings=0 --cache",
    "format": "prettier src/ --write",
    "typecheck": "tsc",
    "prepublishOnly": "node ../../scripts/verify-publish-target.mjs",
    "analyze": "cross-env GENERATE_SOURCEMAP=true npm run build && cross-env NODE_OPTIONS=--no-experimental-fetch source-map-explorer 'build/SplineLoader.js' --no-border-checks",
    "example": "cross-env IS_PROD=true npm run build && vite"
  },
  "peerDependencies": {
    "three": ">=0.133.0"
  },
  "dependencies": {
    "semver-compare": "1.0.0"
  },
  "devDependencies": {
    "@types/semver-compare": "1.0.1",
    "browserslist": "4.16.7",
    "browserslist-to-esbuild": "1.1.1",
    "cross-env": "7.0.3",
    "dpdm": "3.9.0",
    "esbuild": "0.15.16",
    "esbuild-plugin-glslify": "1.0.1",
    "eslint": "8.46.0",
    "glslify-import": "3.1.0",
    "jest": "30.2.0",
    "lodash-es": "4.17.21",
    "prettier": "2.6.2",
    "source-map-explorer": "2.5.2",
    "spe": "*",
    "three": "0.149.0",
    "typescript": "^5.2.2",
    "vite": "5.4.10",
    "vite-plugin-static-copy": "0.13.0"
  },
  "browserslist": {
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ],
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "not IE <= 11",
      "Safari >= 13.0",
      "not Android <= 4.4"
    ]
  }
}
