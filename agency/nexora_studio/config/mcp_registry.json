      "enabled": false,
      "lifecycle": "planned",
      "verified": false,
      "startup_command": "docker",
      "startup_args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "-e",
        "GITHUB_READ_ONLY=1",
        "ghcr.io/github/github-mcp-server"
      ],
      "environment_variables": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "__INJECT_VIA_NEXORA_MCP_CREDENTIAL__",
        "GITHUB_READ_ONLY": "1"
      },
      "initial_verification_mode": "READ_ONLY",
      "capability_filters": [
        "repo.read",
        "issues.read",
        "repo.search",
        "file.read"
      ],
      "repository": "https://github.com/github/github-mcp-server",
      "package": "ghcr.io/github/github-mcp-server",
      "license": "MIT",
      "maintenance_status": "active",
      "authentication_requirements": "GITHUB_PERSONAL_ACCESS_TOKEN",
      "supported_capabilities": [
        "repo.read",
        "repo.search",
        "issues.search",
        "file.read"
      ],
      "priority": 100,
      "provider_type": "repository",
      "requires_authentication": true,
      "limits": {
        "rate_limit": "5000/hour",
        "cost": "free"
      },
      "estimated_latency_ms": 500
    },
